# ==============================================================================
# ProjectPulse — Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or configure in your shell/IDE run configurations).
# Note: .env is git-ignored to prevent credential leaks.
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB Persistence
# ------------------------------------------------------------------------------
# Connection URI for Auth Service database (auth_db)
# Example Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/auth_db?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/auth_db
AUTH_DB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>.mongodb.net/auth_db?retryWrites=true&w=majority

# Connection URI for Domain Service database (domain_db)
# Defaults to AUTH_DB_URI if left unset
DOMAIN_DB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>.mongodb.net/domain_db?retryWrites=true&w=majority

# Connection URI for Notification Service database (notification_db)
# Defaults to DOMAIN_DB_URI or AUTH_DB_URI if left unset
NOTIFICATION_DB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>.mongodb.net/notification_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# HMAC-SHA256 signing secret key (minimum 32 bytes / 256 bits).
# Required in production. In local development, an internal fallback key is used if unset.
JWT_SECRET=your-minimum-32-byte-secure-jwt-secret-key-goes-here!

# Token expiration in seconds (default: 3600 = 1 hour)
JWT_EXPIRATION_SECONDS=3600

# ------------------------------------------------------------------------------
# Apache Kafka Message Broker
# ------------------------------------------------------------------------------
# Kafka broker address (default: localhost:9092 provided by docker-compose.kafka.yml)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Enable Kafka event publishing in domain-service (true / false)
KAFKA_ENABLED=true

# Enable Kafka consumer container startup in notification-service (true / false)
KAFKA_AUTO_STARTUP=true

# ------------------------------------------------------------------------------
# Frontend Service API Endpoints (Vite)
# ------------------------------------------------------------------------------
VITE_AUTH_SERVICE_URL=http://localhost:8082
VITE_DOMAIN_SERVICE_URL=http://localhost:8083
VITE_NOTIFICATION_SERVICE_URL=http://localhost:8085

# ------------------------------------------------------------------------------
# AI Provider Configuration (Optional)
# ------------------------------------------------------------------------------
# ProjectPulse includes a built-in domain-grounded RAG intelligence engine that
# operates directly on MongoDB data without external keys.
# To optionally enable external generative LLM synthesis, provide one of:
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-google-gemini-api-key-here

